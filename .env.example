PLANMYWORKDAY_GOOGLE_CLIENT_ID=
PLANMYWORKDAY_GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/api/auth/google/callback

# Paddle Billing
PADDLE_ENV=sandbox
NEXT_PUBLIC_PADDLE_ENV=sandbox
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_PRICE_ID_PRO_MONTHLY=
PADDLE_PRICE_ID_PRO_MONTHLY_NO_TRIAL=
PADDLE_PRICE_ID_LIFETIME_10_YEAR=
PADDLE_PRICE_ID_LIFETIME_10_YEAR_NO_TRIAL=
PADDLE_TRIAL_ENABLED=1
PADDLE_TRIAL_DAYS=3
PLANMYWORKDAY_MONTHLY_PRICE_LABEL="\$4/mo"
PLANMYWORKDAY_LIFETIME_PRICE_LABEL="\$99"

# Recurrence assistant LLM
# OpenAI: set PLANMYWORKDAY_LLM_PROVIDER=openai and OPENAI_API_KEY.
# Kimi/Moonshot: set PLANMYWORKDAY_LLM_PROVIDER=kimi and KIMI_API_KEY or MOONSHOT_API_KEY.
PLANMYWORKDAY_LLM_PROVIDER=openai
PLANMYWORKDAY_LLM_MODEL=gpt-4o-mini
PLANMYWORKDAY_LLM_API_KEY=
# PLANMYWORKDAY_LLM_BASE_URL=https://api.openai.com/v1
# PLANMYWORKDAY_LLM_JSON_MODE=1
# PLANMYWORKDAY_LLM_TIMEOUT_MS=12000

# Set to 0 only for local migration/debug bypass.
PLANMYWORKDAY_BILLING_ENFORCEMENT=1
